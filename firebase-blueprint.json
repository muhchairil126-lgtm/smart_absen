{
  "entities": {
    "User": {
      "title": "User",
      "description": "Employee or Admin profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "employee"] },
        "employeeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "email"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance record for morning or afternoon",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "session": { "type": "string", "enum": ["morning", "afternoon"] },
        "status": { "type": "string", "enum": ["present", "permit", "sick", "overtime"] },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        },
        "isLate": { "type": "boolean" },
        "lateMinutes": { "type": "number" },
        "overtimeMinutes": { "type": "number" }
      },
      "required": ["userId", "date", "timestamp", "session", "status", "isLate", "lateMinutes", "overtimeMinutes"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "adminComment": { "type": "string" }
      },
      "required": ["userId", "userName", "startDate", "endDate", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    },
    "/leaves/{leaveId}": {
      "schema": "LeaveRequest",
      "description": "Leave requests"
    }
  }
}
